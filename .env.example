# ==============================================================================
# Tremor AI - Environment Configuration
# ==============================================================================

# Free Cloud Database (MongoDB Atlas)
# 1. Create a free cluster on https://www.mongodb.com/cloud/atlas (M0 Free Tier)
# 2. Get your connection string (e.g., mongodb+srv://username:password@cluster0.xxx.mongodb.net/tremor_ai?retryWrites=true&w=majority)
# 3. Paste it below:
MONGODB_URI=
MONGODB_DB_NAME=tremor_ai

# Backend Host & Port Settings
HOST=0.0.0.0
PORT=8000

# Frontend API URL (for Vercel deployment)
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
# VITE_WS_BASE_URL=wss://your-backend-service.onrender.com/ws/telemetry
